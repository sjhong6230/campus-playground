{
  "name": "campus-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Modular Three.js campus destruction sandbox",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && node scripts/build.mjs",
    "format": "prettier --write src scripts tests docs README.md package.json",
    "format:check": "prettier --check src scripts tests docs README.md package.json"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@11.25.0"
}
